<?xml-stylesheet type="text/xsl"?>
<rdf:RDF xml:lang="en"
         xmlns="http://usefulinc.com/ns/doap#"
         xmlns:rdf="http://www.w3.org/1999/02/22-rdf-syntax-ns#"
         xmlns:asfext="http://projects.apache.org/ns/asfext#"
         xmlns:foaf="http://xmlns.com/foaf/0.1/">
  <Project rdf:about="https://flagon.apache.org/">
    <created>2024-04-10</created>
    <license rdf:resource="https://spdx.org/licenses/Apache-2.0" />
    <name>Apache Flagon</name>
    <homepage rdf:resource="https://flagon.apache.org/" />
    <asfext:pmc rdf:resource="https://flagon.apache.org/" />
    <shortdesc>Apache Flagon is an open-source software usability, behavioral logging, and telemetry analytics suite comprising UserALE.js and Distill.</shortdesc>
    <description>Apache Flagon is a software toolset for thin-client behavioral logging, user experience telemetry, and behavioral analytics. It includes UserALE.js (a client-side JavaScript/TypeScript DOM instrumentation library and Manifest V3 WebExtension supporting OpenTelemetry OTLP and Protobuf v1 schemas) and Distill (a Python analytics and graph-modeling library for analyzing UserALE and OpenTelemetry user interaction logs).</description>
    <bug-database rdf:resource="https://github.com/apache/flagon/issues" />
    <mailing-list rdf:resource="https://lists.apache.org/list.html?dev@flagon.apache.org" />
    <download-page rdf:resource="https://flagon.apache.org/releases/" />
    <programming-language>JavaScript</programming-language>
    <programming-language>Python</programming-language>
    <programming-language>TypeScript</programming-language>
    <category rdf:resource="https://projects.apache.org/category/observability" />
    <category rdf:resource="https://projects.apache.org/category/testing" />
    <category rdf:resource="https://projects.apache.org/category/python" />
    <category rdf:resource="https://projects.apache.org/category/javascript" />
    <category rdf:resource="https://projects.apache.org/category/data-visualization" />
    <release>
      <Version>
        <name>Apache Flagon UserALE.js</name>
        <created>2024-02-23</created>
        <revision>2.4.0</revision>
      </Version>
    </release>
    <release>
      <Version>
        <name>Apache Flagon Distill</name>
        <created>2024-02-19</created>
        <revision>0.1.0</revision>
      </Version>
    </release>
    <repository>
      <GitRepository>
        <location rdf:resource="https://github.com/apache/flagon.git"/>
        <browse rdf:resource="https://github.com/apache/flagon/"/>
      </GitRepository>
    </repository>
  </Project>
</rdf:RDF>